# Copy to .env.local; restart Next.js after changes. Never commit .env.local.
# Use your real deployed HTTPS URL in production, e.g. https://mharccardenas.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional for a private dataset; server only:
SANITY_API_READ_TOKEN=
# Standalone Studio: copy these two to .env for the Sanity CLI.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret server-only service-role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a long random secret (e.g. 32 random bytes).
CONTACT_RATE_LIMIT_SECRET=
# Email notification via Resend (server-only). The destination can be your Gmail.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mharcangelo03@gmail.com
CONTACT_FROM_EMAIL=
# Non-Vercel hosts only: header overwritten by your trusted reverse proxy.
TRUSTED_IP_HEADER=x-real-ip
